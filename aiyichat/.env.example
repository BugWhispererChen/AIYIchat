# === 环境变量模板 ===
# 复制为 .env 后填入真实值即可。首次启动（数据库为空）会自动生成 5 组默认 AI 模型配置
# （文本模型/文生图/语音生成/向量模型/图片修改），只需填入同一个阿里云百炼 API Key，
# 也可稍后在管理后台「AI 模型配置」页填写。

# === 应用 ===
APP_ENV=production
LOG_LEVEL=INFO

# === 服务端口（宿主机与容器内端口一致，可用部署脚本 --https-port / --http-port 指定）===
HTTPS_PORT=443
HTTP_PORT=80

# === MongoDB ===
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=aiyichat
USE_MOCK_DB=false

# === LLM ===
# 首次启动时 LLM_API_KEY 为占位符则按默认模型配置生成（qwen3.7-flash 等），
# 填入真实 Key 则按下方旧字段生成基础配置组
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen3.7-plus
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=25

# === 对话 ===
CONTEXT_WINDOW_SIZE=20
SUMMARY_TRIGGER_COUNT=40

# === 限频 ===
RATE_LIMIT_PER_USER=30

# === 管理后台 ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_HOURS=24

# === 阿里云百炼多媒体 ===
# 与 LLM_API_KEY 使用同一个百炼 Key
DASHSCOPE_API_KEY=sk-your-api-key-here
ASR_ENABLED=false
VISION_ENABLED=true
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TTS_ENABLED=true
# 语音动态触发窗口：用户发语音触发语音回复后，该会话在随机时长的固定窗口内
# 文字消息也以语音回复（按会话独立，窗口内不续期，到期需再发语音重新激活）
VOICE_DYNAMIC_ENABLED=true
VOICE_WINDOW_MIN_MINUTES=5
VOICE_WINDOW_MAX_MINUTES=30
IMAGEGEN_ENABLED=true

# === 主动关怀分享（可选，默认值见注释，也可在管理后台热调）===
# 召回触发点按概率发"时事/趣事分享"替代关怀文案，不新增发送频次
PROACTIVE_SHARE_ENABLED=true
# 分享型概率（0~1，其余走原阶段关怀）
PROACTIVE_SHARE_RATIO=0.5
# 分享型中"联网时事"占比（其余为"创作趣事"，禁写时事新闻）
PROACTIVE_SHARE_NEWS_RATIO=0.5

# === 人际关系网络（实体关系图谱增强，可选）===
# Kuzu 图数据库增强开关：启用后实体/关系同步写入图文件，多跳关系查询走 Cypher
# 未启用时自动降级为 MongoDB 一跳查询，功能完整可用
MEMORY_GRAPH_ENABLED=false
# Kuzu 数据文件路径（需挂卷持久化）
MEMORY_GRAPH_PATH=./data/entity_graph

# === QQ Bot（可选，默认留空）===
QQ_APP_ID=
QQ_APP_SECRET=
QQ_BOT_TOKEN=
QQ_SANDBOX_MODE=true
