# === 环境变量模板 ===
# 复制为 .env 后填入真实值即可。QQ / 微信 Bot 凭据不落此处，
# 在管理后台 Bot 管理页录入并保存于数据库，支持热加载。

# === 应用 ===
APP_ENV=production
LOG_LEVEL=INFO

# === 服务端口（宿主机与容器内端口一致，可用部署脚本 --https-port / --http-port 指定）===
HTTPS_PORT=443
HTTP_PORT=80

# === MongoDB ===
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=aiyichat
USE_MOCK_DB=false

# === 阿里云百炼（文本 + 多媒体共用同一个 Key）===
# 首次启动（数据库为空）时，该 Key 会注入自动生成的 5 组默认模型配置
# （文本模型/文生图/语音生成/向量模型/图片修改）；留空则可稍后在
# 管理后台「AI 模型配置」页填写。
DASHSCOPE_API_KEY=sk-your-api-key-here
ASR_ENABLED=false
VISION_ENABLED=true
TTS_ENABLED=true
# 语音动态触发窗口：对方发语音触发语音回复后，该会话在随机时长的固定窗口内
# 文字消息也以语音回复（按会话独立，窗口内不续期，到期需再发语音重新激活）
VOICE_DYNAMIC_ENABLED=true
VOICE_WINDOW_MIN_MINUTES=5
VOICE_WINDOW_MAX_MINUTES=30
IMAGEGEN_ENABLED=true

# === 对话 ===
CONTEXT_WINDOW_SIZE=20
SUMMARY_TRIGGER_COUNT=40

# === 管理后台 ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_HOURS=24

# === 主动关怀分享（可选，默认值见注释，也可在管理后台热调）===
# 召回触发点按概率发"时事/趣事分享"替代关怀文案，不新增发送频次
PROACTIVE_SHARE_ENABLED=true
# 分享型概率（0~1，其余走原阶段关怀）
PROACTIVE_SHARE_RATIO=0.5
# 分享型中"联网时事"占比（其余为"创作趣事"，禁写时事新闻）
PROACTIVE_SHARE_NEWS_RATIO=0.5

# === 人际关系网络（实体关系图谱增强，可选）===
# Kuzu 图数据库增强开关：启用后实体/关系同步写入图文件，多跳关系查询走 Cypher
# 未启用时自动降级为 MongoDB 一跳查询，功能完整可用
MEMORY_GRAPH_ENABLED=false
# Kuzu 数据文件路径（需挂卷持久化）
MEMORY_GRAPH_PATH=./data/entity_graph

# === 记忆注入分层与检索护栏（可选，也可在管理后台「功能实验室」热调）===
# 注意：本节键若曾在管理后台改动过，其值已存入数据库，启动热重载时**数据库值会覆盖本文件**；
# 改这里不生效时请到「功能实验室」调整。
# 稳定层（core 事实）留在系统提示词前段以命中 prompt 前缀缓存，
# 本轮语义召回的记忆改注入到紧贴用户输入的易变段；
# 关闭则全部留在前段（旧行为，逐轮变化会击穿缓存、响应显著变慢）
MEMORY_STABLE_IN_PREFIX=true
# 动态层注入的字符预算（超出后丢弃尾部条目，用于控制 token 增量）
MEMORY_DYNAMIC_MAX_CHARS=600
# 查询向量化的超时秒数：超时即放弃语义召回、只注入稳定层，绝不阻塞对话
MEMORY_RECALL_TIMEOUT_SECONDS=3.0
# 相似度仅来自字符级降级算法时，禁止据此失效旧事实（防误删仍然有效的记忆）
MEMORY_UPDATE_REQUIRES_VECTOR=true
# 隐含情绪识别的字符下界：低于此值视为"嗯/哦"一类无信息量消息，不额外调用 LLM
EMOTION_LLM_MIN_CHARS=4

# === C 端网页身份（自助注册 / 登录 / 会话，默认全部关闭）===
# 硬约束：开关关闭时 QQ / 微信链路与既有 API 行为完全不变，老实例升级无感知。
# 提示：若曾在管理后台「网页身份 / 功能实验室」改过这些项，其值已存入数据库 app_settings，
#       启动热重载时**数据库值会覆盖本文件**，改这里不生效请到后台调整。
# 网页鉴权总开关：关闭时 /api/auth/* 与 /web/* 一律 403
WEB_AUTH_ENABLED=false
# 开放自助注册（需先打开总开关）
WEB_REGISTER_ENABLED=false
# 注册需管理员人工审核后才可登录（合规建议保持 true）
WEB_REGISTER_REQUIRE_REVIEW=true
# 注册/登录图形验证码（算式图，答案一次性消费）
WEB_CAPTCHA_ENABLED=true
# 系统载体渠道：可填一个 platform=web 渠道的 id，作为未自建网页渠道的账号的默认载体；
# 留空时新账号会自动创建一个账号级网页渠道，注册不再因依赖缺失被拒绝
WEB_BOT_ID=
# 新会话默认角色 slug：留空则自动取任一在用公共角色（预置角色均为 public，跨账号可用）
WEB_DEFAULT_PROFILE_SLUG=
# 注册赠送额度模板 id：留空或模板不存在时回落内置体验额度
# （额度单位与后台「套餐计费」一致：文字按 Token 计，语音/图片按次/张；内置值为 文字 20 万 Token / 语音 30 次 / 图片 20 张，30 天有效）
WEB_FREE_QUOTA_TEMPLATE_ID=
# 会话有效期（小时，滑动过期：每次访问顺延）
WEB_SESSION_HOURS=24
# 同一身份并发有效会话上限（超出按创建时间踢掉最旧设备）
WEB_SESSION_MAX_CONCURRENT=3
# 连续登录失败上限与锁定时长（分钟）
WEB_LOGIN_MAX_FAIL=5
WEB_LOGIN_LOCKOUT_MINUTES=15
# 单 IP 滑动窗口限流（窗口 10 分钟；填 0 表示该项不限流）
# 注意：限流与验证码为单实例内存实现，多实例水平扩展时各实例独立计数会失效，
#       需改为 Redis（key 形如 rate_limit:register:{ip}）；
#       反向代理必须以 $remote_addr 覆写 X-Forwarded-For，否则客户端可自造头绕过
WEB_RATE_LIMIT_REGISTER=5
WEB_RATE_LIMIT_LOGIN=20
